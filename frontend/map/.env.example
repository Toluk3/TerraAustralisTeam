# Copiar a .env (no se versiona). Ninguna variable es obligatoria: el mapa no necesita claves.
# Mapa base inicial: claro | calles | oscuro | satelite, o la URL de un estilo de MapLibre
VITE_MAP_STYLE=claro
# mock = JSON de public/mock-api (scripts/build_mocks.py) | api = backend
VITE_DATA_SOURCE=mock
VITE_API_BASE=/api
